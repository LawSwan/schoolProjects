<!DOCTYPE html>
<html>
  <head>
    <title><%= pageTitle %></title>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        font-family: Arial, sans-serif;
        background: #f3f4f6;
        margin: 0;
        padding: 40px 20px;
      }
      .container {
        max-width: 800px;
        margin: 0 auto;
        background: #fff;
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
      }
      .student-name {
        font-size: 0.95rem;
        color: #6b7280;
        margin: 0 0 24px;
        text-align: center;
      }
      .logo {
        display: block;
        margin: 0 auto 24px;
      }
      h1 {
        text-align: center;
        font-size: 2rem;
        color: #1e293b;
        margin: 0 0 32px;
      }
      .definition-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .definition-list li {
        padding: 16px 20px;
        border-left: 4px solid #10b981;
        background: #f8fafc;
        border-radius: 0 8px 8px 0;
        margin-bottom: 16px;
      }
      .definition-list li strong {
        display: block;
        font-size: 1.1rem;
        color: #1e293b;
        margin-bottom: 4px;
      }
      .definition-list li span {
        color: #4b5563;
        font-size: 0.95rem;
        line-height: 1.5;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <p class="student-name"><%= myName %></p>
      <img class="logo" src="img/logo.svg" alt="MEAN Stack Logo" width="400">
      <h1><%= pageTitle %></h1>
      <ul class="definition-list">
        <% definitions.forEach(function(item) { %>
          <li>
            <strong><%= item.term %></strong>
            <span><%= item.definition %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  </body>
</html>
